# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:AAExample-Your-Bot-Token-Here

# Get these from https://developer.spotify.com/dashboard (free, just needs
# a Spotify account). Leave empty to disable the Spotify feature entirely -
# the bot will still work for YouTube/SoundCloud/Instagram.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Where temporary downloaded files are stored (auto-cleaned after each send)
DOWNLOAD_DIR=./downloads

# Where the Real-ESRGAN .pth model weight files live
# (populate this once with: python scripts/download_models.py)
WEIGHTS_DIR=./weights

# How many image-upscale jobs can run at the same time. Keep this at 1 on a
# small CPU-only server - Real-ESRGAN is heavy, and running two at once
# will likely just make both slower / risk running out of RAM.
MAX_CONCURRENT_UPSCALES=1
